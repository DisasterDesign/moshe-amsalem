# ── Client-side (must be set at BUILD time in Cloudflare Pages) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Server-side, Cloudflare Pages Functions (runtime env vars) ──────────────
# Contact form
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Google reviews  (/api/reviews)
# API key from Google Cloud with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=
# Optional. Exact place id. If empty, the function resolves the place once
# per day via Text Search using GOOGLE_PLACE_QUERY.
GOOGLE_PLACE_ID=
# Optional. Defaults to: משה אמסלם - משרד עורכי דין, דרך מנחם בגין 144, תל אביב
GOOGLE_PLACE_QUERY=

# Instagram reels  (/api/reels)
# Long-lived (60-day) access token for the office's own Instagram account,
# generated in the per-client Meta app (created in the client's own Meta
# developer account) under "Instagram API with Instagram Login" (permission
# instagram_business_basic). Store it in Cloudflare Pages as a SECRET
# (encrypted), not a plain variable. Never commit it, never paste it here.
# For local `wrangler pages dev`, put it in .dev.vars (gitignored).
# Pages secrets take effect only on the next deployment: after adding,
# replacing or deleting it, redeploy.
# The secret is the on/off switch:
# - Unset: /api/reels returns { ok: false } and the reels section stays hidden.
# - Switch off: delete the secret and redeploy. Nothing to delete in KV. An
#   edge-cached copy can keep showing for up to 1 hour.
# - Replace: paste the new token as the secret and redeploy. It takes over
#   from the old one automatically.
INSTAGRAM_ACCESS_TOKEN=
# Not an env var: also bind a Workers KV namespace to the Pages project as
# IG_KV (Settings > Bindings, Production only), then redeploy. The function
# stores the refreshed token there, so the 60-day token keeps renewing itself.
# KV holds one record per secret, and records of a replaced or deleted secret
# expire by themselves. Without IG_KV, generate a new token by hand (and
# redeploy) before the 60 days run out.
# Check the setup with GET /api/reels?status=1 (never returns the token).
